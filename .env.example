# Copy to .env for local use, or export these variables in your shell.
# Never commit real values.

# --- Course API (required) -------------------------------------------------
# Bearer token without the word "Bearer" (the script adds it).
API_AUTHORIZATION=
# The api-key header value.
API_KEY=
# Comma-separated teacher ids. Defaults to 231,236.
TEACHER_IDS=231,236

# --- WhatsApp --------------------------------------------------------------
# Group title exactly as it appears in WhatsApp.
WHATSAPP_GROUP_NAME=TTTTT
# Optional: group id (e.g. 1234567890-1234567890@g.us). Takes precedence over name.
WHATSAPP_GROUP_ID=
# Optional: phone number in international format, digits only (e.g. 201012345678).
# When set, pairing uses an 8-digit code instead of a QR image.
WHATSAPP_PHONE_NUMBER=

# --- Encrypted state/session storage ---------------------------------------
# Long random passphrase. Used to encrypt state + the WhatsApp session archive.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOT_STATE_KEY=

# Optional, for local testing only. When set, the encrypted archive is read from
# and written to this path instead of a GitHub release.
# BOT_STATE_LOCAL_ARCHIVE=./.runtime/bot-state.tar.gz.enc

# Optional runtime directory (defaults to ./.runtime).
# RUNTIME_DIR=./.runtime
